{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./finance/**)",
      "Edit(./finance/**)",
      "Read(~/.config/**)",
      "Edit(~/.config/**)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(**/.dev.vars)",
      "Edit(**/.dev.vars)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*secret*)",
      "Read(**/client_secret*)",
      "Read(**/.wrangler/**)",
      "Edit(**/.wrangler/**)",
      "Edit(./gateway/agent-node/**)",
      "Edit(./.claude/**)",
      "Edit(~/.claude/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Bash(wrangler:*)",
      "Bash(npx wrangler:*)",
      "Bash(npm run deploy:*)",
      "Bash(git push:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(git add --all:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(security:*)",
      "Bash(cat ~/.config:*)",
      "Read(~/Library/Keychains/**)",
      "Bash(launchctl:*)",
      "Write",
      "Edit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
