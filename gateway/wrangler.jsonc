{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "vars": {
    "VOICE_ENABLED": "true",
    "AGENT_MODE": "true"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jarvis-assistant",
      "database_id": "4a216683-5d57-448c-942a-28740f2404ed",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
